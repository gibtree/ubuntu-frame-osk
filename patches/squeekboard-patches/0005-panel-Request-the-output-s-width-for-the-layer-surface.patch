@@ -189,10 +193,10 @@ impl Manager {
             unsafe {
                 match update {
                     Update::Hide => c::panel_manager_hide(mgr.panel),
-                    Update::Resize { height }
-                        => c::panel_manager_resize(mgr.panel, *height),
-                    Update::RequestWidget{output, height}
